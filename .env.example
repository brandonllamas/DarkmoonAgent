OLLAMA_URL="http://localhost:11434/api/chat"
LMSTUDIO_URL="http://localhost:1234/v1"
# Opcional si activaste "Require Authentication" en LM Studio 0.4+
LMSTUDIO_API_KEY=""
# Tokens máximos de salida (entero positivo) y timeout de inferencia local
LMSTUDIO_MAX_TOKENS="4096"
LMSTUDIO_TIMEOUT="600"
# auto intenta JSON Schema y cae a prompt estricto si el modelo no lo soporta
LMSTUDIO_STRUCTURED_OUTPUT="auto"

# Router multi-IA (auto recomendado; también: ollama, lmstudio, deepseek, openrouter)
HACKERAGENT_LLM_BACKEND="lmstudio"
# balanced | quality | local | cost
HACKERAGENT_ROUTER_POLICY="balanced"
HACKERAGENT_ROUTER_FALLBACKS="3"
HACKERAGENT_ROUTER_CACHE_TTL="30"

# DeepSeek API (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"  # opciones: deepseek-chat (V3), deepseek-reasoner (R1)

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4"

# Investigación web (opcionales). Sin claves usa DuckDuckGo como respaldo.
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""

# API Keys para herramientas de seguridad
# WPSCAN_API_KEY=""
WPSCAN_API_KEY=""
SHODAN_API_KEY=""
VIRUSTOTAL_API_KEY=""
WHITEINTEL_API_KEY=""

# Navegador preferido (firefox, chromium, chromium-browser)
BROWSER="firefox"
